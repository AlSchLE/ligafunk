# Copy this file to .env for local development.
# .env is gitignored and must never be committed.

# Session signing key (use a long random value in production).
SECRET_KEY=change-me-to-a-long-random-string

# Local database file.
DATABASE_PATH=./sleeper_web.db

# ---------------------------------------------------------------------------
# Durable SQLite replication (production / Render Free)
# ---------------------------------------------------------------------------
# Litestream is only used by the Render start command. Keep these empty for
# normal local development. The bucket must be private.
LITESTREAM_BUCKET=
LITESTREAM_ENDPOINT=
LITESTREAM_REGION=auto
LITESTREAM_REPLICA_PATH=ligafunk/sleeper_web.db
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=

# Session lifetime for team logins (hours).
SESSION_LIFETIME_HOURS=24

# Set to 1 to force HTTPS, HSTS and secure cookies locally (e.g. behind a proxy).
FORCE_HTTPS=0

# Optional comma-separated Host allowlist (prevents Host-header poisoning).
# TRUSTED_HOSTS=sleeper.example.org,example.onrender.com

# ---------------------------------------------------------------------------
# Admin login
# ---------------------------------------------------------------------------
# Preferred: a Werkzeug password hash. Generate one with:
#   python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('YOUR-PASSWORD'))"
ADMIN_PASSWORD_HASH=

# Fallback for local development only (plaintext). Leave empty in production.
ADMIN_PASSWORD=

# Admin session lifetime in hours (default 8).
ADMIN_SESSION_HOURS=8

# ---------------------------------------------------------------------------
# Impressum (German legal notice)
# ---------------------------------------------------------------------------
IMPRESSUM_NAME=
IMPRESSUM_STREET=
IMPRESSUM_CITY=
IMPRESSUM_EMAIL=
